{
  "id": "timer",
  "name": "Count-Up Timer",
  "layout": "fullscreen",
  "state": [
    {"name": "elapsed_ms", "type": "int64", "init": 0},
    {"name": "running",    "type": "bool",  "init": true},
    {"name": "elapsed_txt","type": "string","init": "00:00"}
  ],
  "events": [
    {
      "name": "tick",
      "schedule": {"type": "interval", "ms": 1000},
      "handlers": [
        {
          "guard": {"op": "eq", "a": {"slot": "running"}, "b": {"lit": true}},
          "run": [
            {"add": {"slot": "elapsed_ms", "delta": {"lit": 1000}}},
            {"format": {"slot": "elapsed_txt", "op": "ms", "src": {"slot": "elapsed_ms"}}},
            {"render": {"type": "clear", "color": "black"}},
            {"render": {"type": "text", "x": {"lit": 120}, "y": {"lit": 40}, "src": {"lit": "Timer"}, "font": {"lit": 2}, "color": "yellow", "center": true}},
            {"render": {"type": "text", "x": {"lit": 120}, "y": {"lit": 130}, "src": {"slot": "elapsed_txt"}, "font": {"lit": 6}, "color": "green", "center": true}},
            {"render": {"type": "text", "x": {"lit": 120}, "y": {"lit": 240}, "src": {"lit": "Touch to pause/resume"}, "font": {"lit": 2}, "color": "white", "center": true}}
          ]
        }
      ]
    },
    {
      "name": "touch-down",
      "region": {"x": 0, "y": 0, "w": 240, "h": 320},
      "handlers": [
        {"run": [{"toggle": {"slot": "running"}}]}
      ]
    }
  ]
}
