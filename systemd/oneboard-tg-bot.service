[Unit]
Description=OneBoard Telegram control bot
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/brad/projects/oneboard
# Token goes in the EnvironmentFile (NOT this file, and never in chat):
EnvironmentFile=/home/brad/.hermes/keys/oneboard-telegram.env
# Project-local venv (python-telegram-bot) — set up with:
#   python3 -m venv .venv && .venv/bin/pip install python-telegram-bot
ExecStart=/home/brad/projects/oneboard/.venv/bin/python /home/brad/projects/oneboard/tools/oneboard_bot.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
